<Window x:Class="WPF_SP.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Neptuno - Mantenimiento" Height="800" Width="1250" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="Actualizar" Style="{StaticResource OutlineButton}" Click="Actualizar_Click"/><StackPanel><TextBlock Text="Neptuno" FontSize="26" FontWeight="Bold"/><TextBlock Text="Mantenimiento y reportes · SQL Server" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></DockPanel><TabControl Grid.Row="1" x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
<TabItem Header="Productos"><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Producto" FontSize="20" FontWeight="Bold"/><TextBlock Text="Nombre del producto"/><TextBox x:Name="ProductoNombre" Style="{StaticResource ModernTextBox}"/><TextBlock Text="Proveedor"/><ComboBox x:Name="ProductoProveedor" MinHeight="36" DisplayMemberPath="CompaniaNombre" SelectedValuePath="ProveedorID"/><TextBlock Text="Categoría"/><ComboBox x:Name="ProductoCategoria" MinHeight="36" DisplayMemberPath="NombreCategoria" SelectedValuePath="CategoriaID"/><TextBlock Text="Cantidad por unidad"/><TextBox x:Name="ProductoCantidad" Style="{StaticResource ModernTextBox}"/><TextBlock Text="Precio unitario"/><TextBox x:Name="ProductoPrecio" Style="{StaticResource ModernTextBox}"/><StackPanel Orientation="Horizontal"><Button Content="Guardar" Style="{StaticResource AccentButton}" Click="GuardarProducto_Click"/><Button Content="Eliminar" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Click="EliminarProducto_Click"/></StackPanel></StackPanel><DataGrid x:Name="ProductosGrid" Grid.Column="1" Margin="24,0,0,0" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="ProductoSeleccionado"/></Grid></TabItem>
<TabItem Header="Categorías"><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Categoría" FontSize="20" FontWeight="Bold"/><TextBlock Text="Nombre"/><TextBox x:Name="CategoriaNombre" Style="{StaticResource ModernTextBox}"/><TextBlock Text="Descripción"/><TextBox x:Name="CategoriaDescripcion" Style="{StaticResource ModernTextBox}"/><StackPanel Orientation="Horizontal"><Button Content="Guardar" Style="{StaticResource AccentButton}" Click="GuardarCategoria_Click"/><Button Content="Eliminar" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Click="EliminarCategoria_Click"/></StackPanel></StackPanel><DataGrid x:Name="CategoriasGrid" Grid.Column="1" Margin="24,0,0,0" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="CategoriaSeleccionada"/></Grid></TabItem>
<TabItem Header="Proveedores"><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollViewer><StackPanel><TextBlock Text="Proveedor" FontSize="20" FontWeight="Bold"/><TextBlock Text="Compañía"/><TextBox x:Name="ProveedorCompania" Style="{StaticResource ModernTextBox}"/><TextBlock Text="Nombre de contacto"/><TextBox x:Name="ProveedorContacto" Style="{StaticResource ModernTextBox}"/><TextBlock Text="Cargo de contacto"/><TextBox x:Name="ProveedorCargo" Style="{StaticResource ModernTextBox}"/><TextBlock Text="Dirección"/><TextBox x:Name="ProveedorDireccion" Style="{StaticResource ModernTextBox}"/><TextBlock Text="Ciudad"/><TextBox x:Name="ProveedorCiudad" Style="{StaticResource ModernTextBox}"/><TextBlock Text="Código postal"/><TextBox x:Name="ProveedorCodigoPostal" Style="{StaticResource ModernTextBox}"/><TextBlock Text="País"/><TextBox x:Name="ProveedorPais" Style="{StaticResource ModernTextBox}"/><TextBlock Text="Teléfono"/><TextBox x:Name="ProveedorTelefono" Style="{StaticResource ModernTextBox}"/><TextBlock Text="Fax"/><TextBox x:Name="ProveedorFax" Style="{StaticResource ModernTextBox}"/><StackPanel Orientation="Horizontal"><Button Content="Guardar" Style="{StaticResource AccentButton}" Click="GuardarProveedor_Click"/><Button Content="Eliminar" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Click="EliminarProveedor_Click"/></StackPanel><Separator/><TextBlock Text="Búsqueda de proveedores" FontWeight="Bold"/><TextBlock Text="Nombre de contacto"/><TextBox x:Name="FiltroContacto" Style="{StaticResource ModernTextBox}" TextChanged="BuscarProveedor_TextChanged"/><TextBlock Text="Ciudad"/><TextBox x:Name="FiltroCiudad" Style="{StaticResource ModernTextBox}" TextChanged="BuscarProveedor_TextChanged"/></StackPanel></ScrollViewer><DataGrid x:Name="ProveedoresGrid" Grid.Column="1" Margin="24,0,0,0" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="ProveedorSeleccionado"/></Grid></TabItem>
<TabItem Header="Pedidos y reporte"><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollViewer><StackPanel><TextBlock Text="Pedido" FontSize="20" FontWeight="Bold"/><TextBlock Text="Cliente"/><ComboBox x:Name="PedidoCliente" MinHeight="36" DisplayMemberPath="Empresa" SelectedValuePath="ClienteID"/><TextBlock Text="Empleado"/><ComboBox x:Name="PedidoEmpleado" MinHeight="36" DisplayMemberPath="NombreCompleto" SelectedValuePath="EmpleadoID"/><TextBlock Text="Fecha del pedido"/><DatePicker x:Name="PedidoFecha"/><TextBlock Text="Transportista"/><ComboBox x:Name="PedidoTransportista" MinHeight="36" DisplayMemberPath="CompaniaNombre" SelectedValuePath="TransportistaID"/><TextBlock Text="Destinatario"/><TextBox x:Name="PedidoDestinatario" Style="{StaticResource ModernTextBox}"/><TextBlock Text="Ciudad destino"/><TextBox x:Name="PedidoCiudadDestino" Style="{StaticResource ModernTextBox}"/><TextBlock Text="País destino"/><TextBox x:Name="PedidoPaisDestino" Style="{StaticResource ModernTextBox}"/><StackPanel Orientation="Horizontal"><Button Content="Guardar" Style="{StaticResource AccentButton}" Click="GuardarPedido_Click"/><Button Content="Eliminar" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Click="EliminarPedido_Click"/></StackPanel><Separator/><TextBlock Text="Reporte de detalle por fechas" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="ReporteInicio" Width="145"/><DatePicker x:Name="ReporteFin" Width="145" Margin="8,0,0,0"/></StackPanel><Button Content="Generar reporte" Style="{StaticResource OutlineButton}" Click="Reporte_Click"/></StackPanel></ScrollViewer><DataGrid x:Name="PedidosGrid" Grid.Column="1" Margin="24,0,0,0" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="PedidoSeleccionado"/></Grid></TabItem>
</TabControl><TextBlock Grid.Row="2" x:Name="Estado" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/></Grid></Window>
